# Copy to .env and fill in. Never commit the filled-in file.

ANTHROPIC_API_KEY=sk-ant-...

# Stripe — the secret key stays here; only the publishable key goes in the page.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal REST credentials (PayPal + PayPal Pay Later)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Where the storefront is served from, for CORS
STOREFRONT_ORIGIN=http://localhost:8000

# Optional: exchange rate feed for /api/rates
FX_API_URL=
