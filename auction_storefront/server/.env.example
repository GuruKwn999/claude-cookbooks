# Copy to .env and fill in. Never commit the filled-in file.

ANTHROPIC_API_KEY=sk-ant-...

# Stripe — the secret key stays here; only the publishable key goes in the page.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal REST credentials (PayPal + PayPal Pay Later)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Where the storefront is served from, for CORS
STOREFRONT_ORIGIN=http://localhost:8000

# Live exchange rates (server/fx.py calls Frankfurter — no key needed).
# Set this only if you're swapping in a different provider inside fx.py.
FX_API_URL=

# Stripe Tax — real jurisdiction rates on shipped/freighted sales, instead of
# the flat placeholder rate. Requires Stripe Tax enabled on your account.
STRIPE_TAX_ENABLED=false

# Bearer token for /api/admin/* — set this to something real before exposing
# the admin API anywhere but localhost. Leaving it unset disables those routes.
ADMIN_TOKEN=

# SQLite file path for orders, leads, enquiries and sold state.
# Default: pyli_industries.db next to main.py.
PYLI_DB_PATH=
